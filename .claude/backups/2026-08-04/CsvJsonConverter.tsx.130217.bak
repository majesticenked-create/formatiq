'use client';

import { useMemo, useState } from 'react';

type Mode = 'csvToJson' | 'jsonToCsv';

const SAMPLE_CSV = 'id,name,active\n1,Formatiq,true\n2,"Codebeautify, Inc.",false';
const SAMPLE_JSON = JSON.stringify(
  [
    { id: 1, name: 'Formatiq', active: true },
    { id: 2, name: 'Codebeautify, Inc.', active: false },
  ],
  null,
  2
);

function parseCsvLine(line: string): string[] {
  const fields: string[] = [];
  let field = '';
  let inQuotes = false;

  for (let i = 0; i < line.length; i++) {
    const char = line[i];

    if (inQuotes) {
      if (char === '"') {
        if (line[i + 1] === '"') {
          field += '"';
          i++;
        } else {
          inQuotes = false;
        }
      } else {
        field += char;
      }
    } else if (char === '"') {
      inQuotes = true;
    } else if (char === ',') {
      fields.push(field);
      field = '';
    } else {
      field += char;
    }
  }

  fields.push(field);
  return fields;
}

function parseCsvRows(input: string): string[][] {
  const rows: string[][] = [];
  let row = '';
  let inQuotes = false;

  for (let i = 0; i < input.length; i++) {
    const char = input[i];
    if (char === '"') inQuotes = !inQuotes;
    if (char === '\n' && !inQuotes) {
      rows.push(row);
      row = '';
    } else {
      row += char;
    }
  }
  if (row.length) rows.push(row);

  return rows.map(parseCsvLine);
}

function inferValue(raw: string): unknown {
  if (raw === 'true') return true;
  if (raw === 'false') return false;
  if (raw !== '' && !Number.isNaN(Number(raw))) return Number(raw);
  return raw;
}

function csvToJson(input: string) {
  const trimmed = input.trim();
  if (!trimmed) return { ok: false as const, message: 'Paste some CSV to convert.' };

  const rows = parseCsvRows(trimmed).filter((r) => r.length > 1 || r[0] !== '');
  if (rows.length < 1) return { ok: false as const, message: 'No rows found in CSV input.' };

  const headers = rows[0];
  const dataRows = rows.slice(1);

  const objects = dataRows.map((row) => {
    const obj: Record<string, unknown> = {};
    headers.forEach((header, i) => {
      obj[header] = inferValue(row[i] ?? '');
    });
    return obj;
  });

  return { ok: true as const, output: JSON.stringify(objects, null, 2), rowCount: objects.length, columnCount: headers.length };
}

function csvEscape(value: unknown): string {
  if (value === null || value === undefined) return '';
  const str = typeof value === 'object' ? JSON.stringify(value) : String(value);
  return /[",\n]/.test(str) ? `"${str.replace(/"/g, '""')}"` : str;
}

function jsonToCsv(input: string) {
  let parsed: unknown;
  try {
    parsed = JSON.parse(input);
  } catch (err) {
    return { ok: false as const, message: err instanceof Error ? err.message : 'Invalid JSON' };
  }

  if (!Array.isArray(parsed)) {
    return { ok: false as const, message: 'JSON input must be an array of objects.' };
  }
  if (parsed.length === 0) {
    return { ok: false as const, message: 'JSON array is empty — nothing to convert.' };
  }
  if (!parsed.every((row) => typeof row === 'object' && row !== null && !Array.isArray(row))) {
    return { ok: false as const, message: 'Every array item must be a flat object.' };
  }

  const headers = Array.from(new Set(parsed.flatMap((row) => Object.keys(row as Record<string, unknown>))));
  const lines = [
    headers.join(','),
    ...parsed.map((row) => headers.map((key) => csvEscape((row as Record<string, unknown>)[key])).join(',')),
  ];

  return { ok: true as const, output: lines.join('\n'), rowCount: parsed.length, columnCount: headers.length };
}

export default function CsvJsonConverter() {
  const [mode, setMode] = useState<Mode>('csvToJson');
  const [input, setInput] = useState(SAMPLE_CSV);

  const result = useMemo(() => (mode === 'csvToJson' ? csvToJson(input) : jsonToCsv(input)), [mode, input]);

  function switchMode(next: Mode) {
    setMode(next);
    setInput(next === 'csvToJson' ? SAMPLE_CSV : SAMPLE_JSON);
  }

  function swap() {
    if (result.ok) {
      setInput(result.output);
      setMode(mode === 'csvToJson' ? 'jsonToCsv' : 'csvToJson');
    }
  }

  function copyOutput() {
    if (result.ok) navigator.clipboard.writeText(result.output);
  }

  return (
    <div>
      <div className="control-row">
        <button
          className="icon-btn"
          style={{
            borderColor: mode === 'csvToJson' ? 'var(--accent-dim)' : undefined,
            color: mode === 'csvToJson' ? 'var(--text-primary)' : undefined,
          }}
          onClick={() => switchMode('csvToJson')}
        >
          CSV → JSON
        </button>
        <button
          className="icon-btn"
          style={{
            borderColor: mode === 'jsonToCsv' ? 'var(--accent-dim)' : undefined,
            color: mode === 'jsonToCsv' ? 'var(--text-primary)' : undefined,
          }}
          onClick={() => switchMode('jsonToCsv')}
        >
          JSON → CSV
        </button>
        <button className="icon-btn" onClick={swap} disabled={!result.ok}>
          Swap input ↔ output
        </button>
      </div>

      <div className="panels">
        <div className="panel">
          <div className="panel-bar">
            <span>{mode === 'csvToJson' ? 'CSV' : 'JSON'}</span>
            <div className="panel-actions">
              <button className="icon-btn" onClick={() => setInput('')}>
                Clear
              </button>
            </div>
          </div>
          <textarea className="mono" value={input} onChange={(e) => setInput(e.target.value)} spellCheck={false} />
        </div>

        <div className="panel">
          <div className="panel-bar">
            <span>{mode === 'csvToJson' ? 'JSON' : 'CSV'}</span>
            <div className="panel-actions">
              <button className="icon-btn" onClick={copyOutput} disabled={!result.ok}>
                Copy
              </button>
            </div>
          </div>
          <div className="output mono">{result.ok ? result.output : ''}</div>
          <div className={`status-line ${result.ok ? 'status-valid' : 'status-invalid'}`}>
            {result.ok ? `✓ ${result.rowCount} row(s), ${result.columnCount} column(s)` : `✗ ${result.message}`}
          </div>
        </div>
      </div>
    </div>
  );
}
